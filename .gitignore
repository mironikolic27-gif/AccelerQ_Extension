# --- Generated / large experiment artefacts (do not ship in the PR) ---
# Mined tensors and trained models
data/HEA/*.npy
data/UCCSD/*.npy
data/NN_HEA/*.pt
data/HEA/model_*.json
data/UCCSD/model_*.json
data/HEA/stage2_profiling_*.csv
data/UCCSD/stage2_profiling_*.csv
data/NN_HEA/stage2b_profiling_*.csv
