# Post-hoc analysis plot dumps (regenerate with run_all_analysis.sh)
data/O1/
data/O2/
data/O3/
data/O4/

# Upstream-style pretrained ADPT/QCELS models (not used by HEA / NN_HEA / UCCSD)
models/*.json

# Diagnostics script outputs
diagnostics/*.csv

